# ── Bytecode / cachés de Python ─────────────────────────────────────────
# Se regeneran solos al importar; versionarlos provoca conflictos de merge
# y bloquea operaciones de git (stash/pop, checkout) al correr los tests.
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Entornos virtuales ─────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── Herramientas / cachés de test y análisis ──────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ── IDEs / editores ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Sistema operativo ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Artefactos de este proyecto ──────────────────────────────────────
# Logs de corridas de PRUEBA (throwaway).
logs/smoke_*.json
logs/_run_*.txt
logs/prueba_determinismo_*.json

# Harness experimental: los Parquet POR CORRIDA, los logs JSON del middleware
# y los tracebacks de fallos son voluminosos y regenerables. Los CONSOLIDADOS
# (resultados/*.parquet) NO se ignoran: van en el material suplementario /
# reproducibilidad (setup §10).
resultados/corridas/
resultados/corridas_propuesto/
resultados/logs_middleware/
resultados/fallos/
tests/_tmp_resultados/
Avance 1/

# Archivo basura de una redirección de shell fallida (pip ... 'tqdm>=4.65')
/4.65

# Resultados crudos de la parrilla repartida en dos computadores (README_MAC):
# Ubuntu (resultados_A) y Mac Studio (resultados_MAC), más sus comprimidos.
resultados_A/
resultados_MAC/
# De la unión solo se versionan los consolidados (insumo de analisis/main.py).
Resultados_Union/*
!Resultados_Union/corridas.parquet
!Resultados_Union/corridas_propuesto.parquet
resultados_ubuntu.zip
resultados_MAC.zip
